{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "E-commerce store product item in catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "basePriceUSD": { "type": "number" },
        "inStock": { "type": "boolean" },
        "description": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "name", "brand", "category", "basePriceUSD"]
    },
    "StockNotification": {
      "title": "StockNotification",
      "description": "Customer request to be notified when out-of-stock item is back in stock",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "variantId": { "type": "string" },
        "variantName": { "type": "string" },
        "contactType": { "type": "string", "enum": ["whatsapp", "email"] },
        "contactValue": { "type": "string" },
        "customerName": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "notified"] },
        "requestedVia": { "type": "string" }
      },
      "required": ["id", "productId", "productName", "contactType", "contactValue", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order placed for electronics in Lebanon with delivery and status tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deliveryRegion": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "deliveryType": { "type": "string", "enum": ["delivery", "pickup"] },
        "paymentMethod": { "type": "string" },
        "totalUSD": { "type": "number" },
        "deliveryFeeUSD": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "processing", "out_for_delivery", "delivered", "cancelled"]
        },
        "statusDescription": { "type": "string" },
        "courier": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "estimatedDelivery": { "type": "string" },
        "items": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerName", "customerPhone", "totalUSD", "status", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store catalog products collection"
    },
    "/stockNotifications/{notificationId}": {
      "schema": "StockNotification",
      "description": "Customer restock notification alerts"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store customer orders and live dispatch tracking updates"
    }
  }
}
