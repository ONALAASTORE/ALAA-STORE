<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <radialGradient id="bgGrad" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="85%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#e2e8f0"/>
    </radialGradient>
    
    <!-- 3D Red Extrusion Gradient -->
    <linearGradient id="redGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FF1A1A"/>
      <stop offset="70%" stop-color="#FF0000"/>
      <stop offset="100%" stop-color="#CC0000"/>
    </linearGradient>

    <!-- Gloss Highlight -->
    <linearGradient id="gloss" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.8"/>
      <stop offset="50%" stop-color="#ffffff" stop-opacity="0.1"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
    </linearGradient>

    <!-- Drop Shadow Filter -->
    <filter id="logoShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#FF0000" flood-opacity="0.35"/>
      <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#000000" flood-opacity="0.2"/>
    </filter>
  </defs>

  <!-- Circular Container -->
  <circle cx="250" cy="250" r="240" fill="url(#bgGrad)" stroke="#e2e8f0" stroke-width="4" filter="url(#logoShadow)"/>

  <!-- Glossy Reflection Top Arch -->
  <path d="M 50,210 C 60,110 140,50 250,50 C 360,50 440,110 450,210 C 370,160 290,140 250,140 C 210,140 130,160 50,210 Z" fill="url(#gloss)"/>

  <!-- Logo Graphics Group -->
  <g transform="translate(0, 10)">
    <!-- O with Play Button -->
    <g transform="translate(92, 235)">
      <!-- Outer Red Ring (The 'O') -->
      <circle cx="0" cy="0" r="42" fill="none" stroke="url(#redGrad)" stroke-width="19"/>
      <!-- Inner Play Triangle -->
      <path d="M -10,-20 L 18,0 L -10,20 Z" fill="url(#redGrad)"/>
    </g>

    <!-- 'N  ALAA' text in bold red -->
    <g font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="88" fill="url(#redGrad)" letter-spacing="1">
      <!-- N -->
      <text x="145" y="265" text-anchor="start">N</text>
      <!-- ALAA -->
      <text x="218" y="265" text-anchor="start">ALAA</text>
    </g>

    <!-- 'STORE' in metallic bold black/slate -->
    <text x="250" y="345" font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="54" fill="#0f172a" letter-spacing="12" text-anchor="middle">
      STORE
    </text>
  </g>
</svg>
